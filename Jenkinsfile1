pipeline {
    agent any

    environment {
        SONARQUBE_URL = 'http://localhost:9000'   // SonarQube server URL
        SONARQUBE_TOKEN = credentials('sonar-token') // Jenkins stored token
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'branch#1', url: 'https://github.com/Java-Class-01/TaskSeven.git'
            }
        }

        stage('Build') {
            steps {
                // For Maven projects
                bat 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') { // Name of SonarQube server configured in Jenkins
                    bat "mvn sonar:sonar -Dsonar.projectKey=YourProjectKey -Dsonar.host.url=${SONARQUBE_URL} -Dsonar.login=${SONARQUBE_TOKEN}"
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
}
